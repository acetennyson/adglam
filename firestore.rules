rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.role in ['contributor','editor','owner']; }
    // All writes to team data go through the server (Admin SDK bypasses these rules).
    match /admins/{id}   { allow read: if isAdmin(); allow write: if false; }
    match /invites/{id}  { allow read, write: if false; }
    match /auditLog/{id} { allow read: if request.auth != null && request.auth.token.role == 'owner'; allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
