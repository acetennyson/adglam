# Firebase web app config (Project settings > General > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Service account (Project settings > Service accounts > Generate new private key). SERVER ONLY.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
# TikTok embed style: leave empty for the Embed Player (default), or set to "classic" for the older /embed/v2 page
NEXT_PUBLIC_TIKTOK_EMBED=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email alerts (Nodemailer / SMTP). Messages are always saved to Firestore and shown in /admin/messages.
MY_Mail=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=service@example.com
SMTP_PASS=your-16-letter-app-password
MAIL_FROM=ADGlam Mail <service@example.com>
IP_SALT=

# Analytics (PostHog). Leave the key empty to turn analytics and the cookie banner off.
# Region must match your PostHog project: us or eu. These are baked in at build time, so redeploy after changing them.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_REGION=us
